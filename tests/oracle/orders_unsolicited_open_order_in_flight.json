  {"call": "reqOpenOrdersAsync", "as": "r"},
  {"read": [
   ["openOrder", 0, {"ref": "msft"}, {"@": "Order", "orderId": 0, "clientId": 0, "permId": 9100, "action": "BUY", "totalQuantity": 10.0, "orderType": "LMT", "lmtPrice": 400.0, "tif": "GTC", "account": "DU1"}, {"@": "OrderState", "status": "Submitted"}]
  ]},
  {"read": [
   ["openOrderEnd"]
  ]},
  {"read": [
   ["openOrder", 0, {"ref": "msft"}, {"@": "Order", "orderId": 0, "clientId": 0, "permId": 9101, "action": "SELL", "totalQuantity": 5.0, "orderType": "LMT", "lmtPrice": 410.0, "tif": "GTC", "account": "DU1"}, {"@": "OrderState", "status": "Submitted"}]
  ]}
 ]
}

{
 "about": "While an open-orders exchange is in flight every open order is recorded for it and fires no openOrderEvent; after its end one does (wrapper.py:668-720)",
 "connected": {"client_id": 1, "next_id": 1, "accounts": ["DU1"]},
 "steps": [
